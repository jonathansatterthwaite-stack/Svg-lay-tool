{
  "name": "svg-lay-tool",
  "version": "0.1.0",
  "description": "Embeddable layer-based shape image editor. Compose images from a library of shapes on layers with colour, transform, masks, effects and groups. Renders to SVG.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "svg",
    "editor",
    "layers",
    "shapes",
    "mask",
    "emblem",
    "decal",
    "image-editor",
    "web-component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/svg-lay-tool.js",
  "module": "./dist/svg-lay-tool.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/svg-lay-tool.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.iife.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --outDir dist-demo"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://jonathansatterthwaite-stack.github.io/Svg-lay-tool/"
}
